{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon Copy API",
    "version": "1.0.0",
    "description": "Programmatic access to Carbon Copy's Polymarket copy-trading platform. Follow traders, manage your portfolio, and automate your prediction market strategy.",
    "contact": {
      "name": "Carbon Copy Support",
      "email": "support@carboncopy.news",
      "url": "https://carboncopy.inc"
    }
  },
  "servers": [
    {
      "url": "https://carboncopy.inc",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key in the format `cc_<64 hex characters>`. Obtain from the Dashboard under Settings \u2192 API Keys."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "method_not_allowed",
                  "conflict",
                  "quota_exceeded",
                  "rate_limited",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable description of the error."
              }
            }
          }
        }
      },
      "PaginationQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Number of records to return per page."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from a previous response's `continueCursor` field."
          },
          "since": {
            "type": "integer",
            "description": "Filter to records created at or after this Unix timestamp (milliseconds)."
          },
          "until": {
            "type": "integer",
            "description": "Filter to records created before this Unix timestamp (milliseconds)."
          }
        }
      },
      "PaginatedResponse": {
        "type": "object",
        "required": [
          "page",
          "isDone"
        ],
        "properties": {
          "page": {
            "type": "array",
            "items": {}
          },
          "continueCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass this value as `cursor` in your next request to fetch the following page. `null` when no more pages exist."
          },
          "isDone": {
            "type": "boolean",
            "description": "`true` when this is the last page of results."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "timestamp": {
            "type": "integer",
            "description": "Current server time as Unix timestamp (milliseconds).",
            "example": 1741600000000
          }
        }
      },
      "PortfolioSummary": {
        "type": "object",
        "required": [
          "totalValue",
          "activePositions",
          "totalPnL",
          "totalPnLPercent",
          "winRate",
          "totalTrades",
          "traders"
        ],
        "properties": {
          "totalValue": {
            "type": "number",
            "description": "Current portfolio value in USDC.",
            "example": 5420.75
          },
          "activePositions": {
            "type": "integer",
            "description": "Number of currently open copy-trade positions.",
            "example": 12
          },
          "totalPnL": {
            "type": "number",
            "description": "Lifetime profit/loss in USDC.",
            "example": 420.5
          },
          "totalPnLPercent": {
            "type": "number",
            "description": "Lifetime P&L as a percentage of invested capital.",
            "example": 8.41
          },
          "winRate": {
            "type": "number",
            "description": "Percentage of resolved copy trades that were profitable.",
            "example": 62.5
          },
          "totalTrades": {
            "type": "integer",
            "description": "Total number of copy trades executed.",
            "example": 48
          },
          "traders": {
            "type": "array",
            "description": "Summary stats for each followed trader.",
            "items": {
              "$ref": "#/components/schemas/TraderSummary"
            }
          }
        }
      },
      "TraderSummary": {
        "type": "object",
        "required": [
          "walletAddress",
          "copyTradingEnabled",
          "copyPercentage"
        ],
        "properties": {
          "walletAddress": {
            "type": "string",
            "description": "Trader's Ethereum wallet address.",
            "example": "0xAbCd1234..."
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional display name for the trader.",
            "example": "alpha_trader"
          },
          "copyTradingEnabled": {
            "type": "boolean",
            "description": "`true` if copy trading is currently active for this trader."
          },
          "copyPercentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Percentage of each trade to copy.",
            "example": 25
          },
          "maxCopyAmount": {
            "type": [
              "number",
              "null"
            ],
            "description": "Maximum USDC to deploy per copied trade. `null` means no cap.",
            "example": 500
          },
          "totalCopied": {
            "type": "integer",
            "description": "Total number of trades copied from this trader.",
            "example": 14
          },
          "pnl": {
            "type": "number",
            "description": "P&L in USDC from trades copied from this trader.",
            "example": 128.4
          }
        }
      },
      "TraderDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TraderSummary"
          },
          {
            "type": "object",
            "properties": {
              "notificationsEnabled": {
                "type": "boolean",
                "description": "Whether push/email notifications are enabled for this trader's activity."
              },
              "followedAt": {
                "type": "integer",
                "description": "Unix timestamp (ms) when you started following this trader.",
                "example": 1741500000000
              },
              "recentTrades": {
                "type": "array",
                "description": "The 10 most recent trades by this trader.",
                "items": {
                  "$ref": "#/components/schemas/CopyTrade"
                }
              }
            }
          }
        ]
      },
      "CopyTrade": {
        "type": "object",
        "required": [
          "id",
          "traderWallet",
          "marketId",
          "side",
          "amount",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Convex document ID.",
            "example": "k17abc123def456"
          },
          "traderWallet": {
            "type": "string",
            "description": "Wallet address of the trader being copied.",
            "example": "0xAbCd1234..."
          },
          "marketId": {
            "type": "string",
            "description": "Polymarket condition/market ID.",
            "example": "0x1234abcd..."
          },
          "marketQuestion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable market question.",
            "example": "Will BTC exceed $100k by end of 2025?"
          },
          "side": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ],
            "description": "Which outcome was purchased."
          },
          "amount": {
            "type": "number",
            "description": "USDC amount deployed in this trade.",
            "example": 50.0
          },
          "price": {
            "type": "number",
            "description": "Average fill price (0\u20131).",
            "example": 0.62
          },
          "pnl": {
            "type": [
              "number",
              "null"
            ],
            "description": "Realized P&L in USDC. `null` if the market is still open.",
            "example": 12.5
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved_win",
              "resolved_loss",
              "cancelled"
            ],
            "description": "Current status of this copy trade."
          },
          "orderId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Associated order ID, if an order was placed.",
            "example": "k17xyz789"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp (ms) when the trade was copied.",
            "example": 1741550000000
          },
          "resolvedAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix timestamp (ms) when the market resolved. `null` if still open."
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "marketId",
          "side",
          "amount",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Convex document ID.",
            "example": "k17xyz789"
          },
          "marketId": {
            "type": "string",
            "description": "Polymarket condition/market ID."
          },
          "marketQuestion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable market question."
          },
          "side": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "amount": {
            "type": "number",
            "description": "USDC amount requested.",
            "example": 50.0
          },
          "filledAmount": {
            "type": [
              "number",
              "null"
            ],
            "description": "USDC amount actually filled.",
            "example": 50.0
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average fill price (0\u20131).",
            "example": 0.62
          },
          "status": {
            "type": "string",
            "enum": [
              "filled",
              "pending",
              "cancelled",
              "failed"
            ],
            "description": "Current order status."
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp (ms) when the order was created.",
            "example": 1741550000000
          },
          "filledAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix timestamp (ms) when the order was filled."
          },
          "errorMessage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable error, populated when status is `failed`."
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "userId",
          "walletAddress",
          "createdAt"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "Internal Carbon Copy user ID.",
            "example": "user_abc123"
          },
          "walletAddress": {
            "type": [
              "string",
              "null"
            ],
            "description": "User's connected Polymarket wallet address.",
            "example": "0xDead1234..."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "User's email address, if provided.",
            "example": "trader@example.com"
          },
          "copyTradingEnabled": {
            "type": "boolean",
            "description": "Global kill-switch for copy trading.",
            "example": true
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp (ms) of account creation.",
            "example": 1740000000000
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "required": [
          "keyId",
          "name",
          "scopes",
          "createdAt"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "description": "Unique ID for this key.",
            "example": "key_abc123"
          },
          "name": {
            "type": "string",
            "description": "Human-readable label.",
            "example": "My trading bot"
          },
          "scopes": {
            "$ref": "#/components/schemas/KeyScopes"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp (ms) of key creation.",
            "example": 1741000000000
          },
          "expiresAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix timestamp (ms) of key expiry. `null` = never expires."
          },
          "lastUsedAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix timestamp (ms) when the key was last used."
          }
        }
      },
      "ApiKeyWithSecret": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiKey"
          },
          {
            "type": "object",
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "type": "string",
                "description": "The full API key secret (`cc_<64 hex chars>`). Shown **once** \u2014 store it securely.",
                "example": "cc_a1b2c3d4e5f6..."
              }
            }
          }
        ]
      },
      "KeyScopes": {
        "type": "object",
        "properties": {
          "portfolio": {
            "type": "string",
            "enum": [
              "none",
              "read"
            ],
            "default": "none"
          },
          "traders": {
            "type": "string",
            "enum": [
              "none",
              "read",
              "write"
            ],
            "default": "none"
          },
          "orders": {
            "type": "string",
            "enum": [
              "none",
              "read",
              "write"
            ],
            "default": "none"
          },
          "markets": {
            "type": "string",
            "enum": [
              "none",
              "read"
            ],
            "default": "none"
          },
          "account": {
            "type": "string",
            "enum": [
              "none",
              "read"
            ],
            "default": "none"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid authentication credentials.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "unauthorized",
                "message": "Invalid or missing API key."
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but insufficient permissions (wrong scope).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "forbidden",
                "message": "This key does not have the required scope."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "not_found",
                "message": "Resource not found."
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests. Back off and retry.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Request limit for this endpoint tier.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Remaining requests in the current window.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "rate_limited",
                "message": "Rate limit exceeded. Retry after 30 seconds."
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns API health status. No authentication required. Use this to verify connectivity.",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "API is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "1.0.0",
                  "timestamp": 1741600000000
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/portfolio": {
      "get": {
        "operationId": "getPortfolio",
        "summary": "Get portfolio summary",
        "description": "Returns an aggregated summary of your copy-trading portfolio including total value, P&L, win rate, and per-trader breakdowns.",
        "tags": [
          "Portfolio"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Portfolio summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/portfolio/history": {
      "get": {
        "operationId": "getPortfolioHistory",
        "summary": "List copy trade history",
        "description": "Returns a paginated list of all copy trades (open and resolved). Use cursor-based pagination to iterate through large result sets.",
        "tags": [
          "Portfolio"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of records per page (1\u2013100, default 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor from a previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Return trades created at or after this Unix timestamp (ms).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "Return trades created before this Unix timestamp (ms).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated copy trade history.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CopyTrade"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/portfolio/positions": {
      "get": {
        "operationId": "getPortfolioPositions",
        "summary": "List open positions",
        "description": "Returns a paginated list of currently open copy-trade positions (status = `open`).",
        "tags": [
          "Portfolio"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated open positions.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CopyTrade"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/traders": {
      "get": {
        "operationId": "listTraders",
        "summary": "List followed traders",
        "description": "Returns all traders you currently follow, including their copy-trading settings and performance stats.",
        "tags": [
          "Traders"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of followed traders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "traders"
                  ],
                  "properties": {
                    "traders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TraderSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "followTrader",
        "summary": "Follow a trader",
        "description": "Start copy-trading a new wallet address. Returns `409 Conflict` if you are already following this trader.",
        "tags": [
          "Traders"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "walletAddress",
                  "copyPercentage"
                ],
                "properties": {
                  "walletAddress": {
                    "type": "string",
                    "description": "Ethereum wallet address to follow.",
                    "example": "0xAbCd1234..."
                  },
                  "copyPercentage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Percentage of each trade to copy.",
                    "example": 25
                  },
                  "maxCopyAmount": {
                    "type": "number",
                    "description": "Maximum USDC to deploy per trade. Omit for no cap.",
                    "example": 500
                  },
                  "notificationsEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to receive notifications for this trader's activity."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trader followed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraderDetail"
                }
