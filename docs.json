{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Carbon Copy",
  "description": "Programmatic access to Polymarket copy-trading. Manage portfolios, follow traders, and track orders via REST API or MCP.",
  "colors": {
    "primary": "#285e9f",
    "light": "#4075aa",
    "dark": "#285e9f"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://carboncopy.inc"
  },
  "fonts": {
    "heading": {
      "family": "Playfair Display",
      "weight": 800
    },
    "body": {
      "family": "Source Serif 4"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Playfair Display"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              {
                "page": "index",
                "icon": "house"
              },
              {
                "page": "quickstart",
                "icon": "rocket"
              },
              {
                "page": "authentication",
                "icon": "shield-halved"
              }
            ]
          },
          {
            "group": "Reference",
            "pages": [
              {
                "page": "rate-limits",
                "icon": "gauge-high"
              },
              {
                "page": "errors",
                "icon": "triangle-exclamation"
              },
              {
                "page": "pagination",
                "icon": "arrow-right"
              }
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              {
                "page": "mcp-server",
                "icon": "robot"
              }
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@carboncopy.inc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://carboncopy.inc"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/CarbonCopyInc",
      "github": "https://github.com/CarbonCopyInc"
    }
  }
}
