            "icon": "plug",
            "pages": [
              "mcp-server"
            ]
          }
        ]
      },
      {
        "tab": "Polymarket MCP",
        "icon": "chart-network",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "play",
