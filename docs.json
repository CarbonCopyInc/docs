    "heading": {
      "family": "Playfair Display",
      "weight": 800
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Playfair Display"
    }
  },
